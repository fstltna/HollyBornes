; ============================================================================
; HOLLYBORNES  -  Hollywood + RapaGUI
; Play against the Computer, or online against another human through the
; matchmaking server (see server/hollyserver.c). First to exactly 1000 km wins.
; Requires: Hollywood 9+ and the RapaGUI plugin.
; Run with:  Hollywood HollyBornes.hws      (or compile it to an executable)
; ============================================================================

@REQUIRE "rapagui.hwp"

@APPTITLE "HollyBornes"
@APPVERSION "$VER: HollyBornes 1.8 (28.10.2026)"
@APPAUTHOR "You"
@APPCOPYRIGHT "Public domain"
@APPDESCRIPTION "The classic French road-race card game"

; Application icon: shown in the window border and task bar, and embedded in
; executables compiled on Windows and macOS. The PNG files live in the "icons"
; folder next to this script, so keep that folder with it.
@APPICON {Ic16x16 = "icons/icon16.png",
Ic24x24 = "icons/icon24.png",
Ic32x32 = "icons/icon32.png",
Ic48x48 = "icons/icon48.png",
Ic64x64 = "icons/icon64.png",
Ic96x96 = "icons/icon96.png",
Ic128x128 = "icons/icon128.png",
Ic256x256 = "icons/icon256.png",
Ic512x512 = "icons/icon512.png",
Ic1024x1024 = "icons/icon1024.png"}

; ---- Card IDs --------------------------------------------------------------
Const #D25    = 0
Const #D50    = 1
Const #D75    = 2
Const #D100   = 3
Const #D200   = 4
Const #ACC    = 5    ; hazards
Const #GAS    = 6
Const #TIRE   = 7
Const #LIM    = 8
Const #STOP   = 9
Const #REP    = 10   ; remedies
Const #FUEL   = 11
Const #SPARE  = 12
Const #ENDLIM = 13
Const #GO     = 14
Const #ACE    = 15   ; safeties
Const #TANK   = 16
Const #PROOF  = 17
Const #ROW    = 18

; ---- Player status (besides the hazard IDs themselves) ---------------------
Const #ROLL   = 20   ; free to drive
Const #NEEDGO = 21   ; stopped, needs a GO card

Const #NETID  = 1    ; connection identifier used for the matchmaking server

Global G
G = {}
G.mode = 0            ; 0 = vs computer, 1 = online
G.net = False         ; connected to the matchmaking server?
G.myturn = True
G.over = True
G.seat = 0
G.rx = ""             ; receive buffer
G.oppname = "Computer"
G.sel = -1
G.welcomed = False    ; server accepted our HELLO / LOGIN
G.login = ""          ; account name when logged in with a password
G.myname = ""         ; the name we introduced ourselves with (guest or account)
G.lsuffix = ""        ; stats shown next to the login indicator
G.fn = {}             ; friends panel: names, kinds (0 friend, 1 request), status
G.ft = {}
G.fs = {}
G.fcnt = 0
G.sn = {}             ; what the friends list currently shows (for selection)
G.sk = {}
G.sc = 0
G.fsel = -1
G.sndok = False       ; the card sound was created successfully
G.sndon = True        ; sound switched on (Game menu)
G.pop = ""            ; lines collected for popups (history, leaderboard)

; ============================================================================
;  CARD DATABASE
; ============================================================================
Function p_Count(c)
   If c <= #D75 Then Return(10)
   If c = #D100 Then Return(12)
   If c = #D200 Then Return(4)
   If c = #ACC Or c = #GAS Or c = #TIRE Then Return(3)
   If c = #LIM Then Return(4)
   If c = #STOP Then Return(5)
   If c = #REP Or c = #FUEL Or c = #SPARE Or c = #ENDLIM Then Return(6)
   If c = #GO Then Return(14)
   Return(1)
EndFunction

Function p_Name$(c)
   Switch c
   Case #D25:    Return("25 km")
   Case #D50:    Return("50 km")
   Case #D75:    Return("75 km")
   Case #D100:   Return("100 km")
   Case #D200:   Return("200 km")
   Case #ACC:    Return("ACCIDENT (hazard)")
   Case #GAS:    Return("OUT OF GAS (hazard)")
   Case #TIRE:   Return("FLAT TIRE (hazard)")
   Case #LIM:    Return("SPEED LIMIT (hazard)")
   Case #STOP:   Return("STOP (hazard)")
   Case #REP:    Return("Repairs (remedy)")
   Case #FUEL:   Return("Gasoline (remedy)")
   Case #SPARE:  Return("Spare Tire (remedy)")
   Case #ENDLIM: Return("End of Limit (remedy)")
   Case #GO:     Return("GO (remedy)")
   Case #ACE:    Return("* Driving Ace * (safety)")
   Case #TANK:   Return("* Extra Tank * (safety)")
   Case #PROOF:  Return("* Puncture-Proof * (safety)")
   Case #ROW:    Return("* Right of Way * (safety)")
   EndSwitch
   Return("?")
EndFunction

Function p_Short$(c)
   ; short card name for the log
   Switch c
   Case #ACC:    Return("Accident")
   Case #GAS:    Return("Out of Gas")
   Case #TIRE:   Return("Flat Tire")
   Case #LIM:    Return("Speed Limit")
   Case #STOP:   Return("Stop")
   Case #REP:    Return("Repairs")
   Case #FUEL:   Return("Gasoline")
   Case #SPARE:  Return("Spare Tire")
   Case #ENDLIM: Return("End of Limit")
   Case #GO:     Return("GO")
   Case #ACE:    Return("Driving Ace")
   Case #TANK:   Return("Extra Tank")
   Case #PROOF:  Return("Puncture-Proof")
   Case #ROW:    Return("Right of Way")
   EndSwitch
   Return(p_Name$(c))
EndFunction

Function p_Kind(c)
   If c <= #D200 Then Return(0)   ; distance
   If c <= #STOP Then Return(1)   ; hazard
   If c <= #GO Then Return(2)     ; remedy
   Return(3)                      ; safety
EndFunction

Function p_DistKm(c)
   Switch c
   Case #D25:  Return(25)
   Case #D50:  Return(50)
   Case #D75:  Return(75)
   Case #D100: Return(100)
   Case #D200: Return(200)
   EndSwitch
   Return(0)
EndFunction

; index (0..3) of the safety that protects against hazard h
Function p_SafIdx(h)
   Switch h
   Case #ACC:  Return(0)
   Case #GAS:  Return(1)
   Case #TIRE: Return(2)
   EndSwitch
   Return(3)   ; limit + stop -> Right of Way
EndFunction

Function p_Who$(w)
   If w = 0 Then Return("You")
   Return(G.oppname)
EndFunction

Function p_Obj$(w)
   If w = 0 Then Return("you")
   If G.mode = 0 Then Return("the " .. G.oppname)
   Return(G.oppname)
EndFunction

Function p_S$(n)
   Return("" .. n)
EndFunction

Function p_Clean$(s$)
   s$ = ReplaceStr(s$, " ", "_")
   Return(LeftStr(s$, 16))
EndFunction

; ============================================================================
;  GAME STATE
; ============================================================================
; ============================================================================
;  SOUND  (the card sound is synthesised at startup, so no sound file is needed)
; ============================================================================
Function p_InitSound()
   Local t, i, n, y, env, v, err
   n = 1800                       ; about 80 ms at 22050 Hz
   t = {}
   y = 0
   env = 1.0
   For i = 0 To n - 1
      y = (y * 2 + (Rnd(256) - 128)) / 3    ; soft noise: a card snapping onto the table
      v = Int(y * env * 1.6)
      If v > 127 Then v = 127
      If v < -128 Then v = -128
      t[i] = v
      env = env * 0.9975                    ; fast decay
   Next
   ExitOnError(False)
   CreateSample(1, t, 22050)
   err = GetLastError()
   ExitOnError(True)
   If err = 0 Then G.sndok = True
EndFunction

Function p_PlaySound()
   If G.sndok = True And G.sndon = True Then PlaySample(1)
EndFunction

Function p_ToggleSound()
   If G.sndok = False
      p_Log("Sound is not available on this system.")
      Return
   EndIf
   If G.sndon = True
      G.sndon = False
      p_Log("Sound off.")
   Else
      G.sndon = True
      p_Log("Sound on.")
      p_PlaySound()
   EndIf
EndFunction

Function p_NewPlayer()
   Local p, i
   p = {}
   p.km = 0
   p.status = #NEEDGO
   p.limit = False
   p.n200 = 0
   p.hn = 0
   p.hand = {}
   p.saf = {}
   For i = 0 To 3
      p.saf[i] = False
   Next
   Return(p)
EndFunction

Function p_BuildDeck()
   Local c, k, i, j, t
   G.deck = {}
   G.dn = 0
   For c = 0 To 18
      For k = 1 To p_Count(c)
         G.deck[G.dn] = c
         G.dn = G.dn + 1
      Next
   Next
   For i = G.dn - 1 To 1 Step -1
      j = Rnd(i + 1)
      t = G.deck[i]
      G.deck[i] = G.deck[j]
      G.deck[j] = t
   Next
EndFunction

Function p_Draw(w)
   If G.dn <= 0 Then Return(False)
   If G.P[w].hn >= 7 Then Return(False)
   G.dn = G.dn - 1
   G.P[w].hand[G.P[w].hn] = G.deck[G.dn]
   G.P[w].hn = G.P[w].hn + 1
   Return(True)
EndFunction

Function p_Remove(w, slot)
   Local i
   For i = slot To G.P[w].hn - 2
      G.P[w].hand[i] = G.P[w].hand[i + 1]
   Next
   G.P[w].hn = G.P[w].hn - 1
EndFunction

Function p_Log(s$)
   moai.DoMethod("log", "insert", "top", s$)
EndFunction

; ============================================================================
;  RULES
; ============================================================================
Function p_CanPlay(w, c)
   Local o, k, st
   o = 1 - w
   k = p_Kind(c)
   st = G.P[w].status

   If k = 0
      If st <> #ROLL Then Return(False)
      If G.P[w].km + p_DistKm(c) > 1000 Then Return(False)
      If G.P[w].limit = True And p_DistKm(c) > 50 Then Return(False)
      If c = #D200 And G.P[w].n200 >= 2 Then Return(False)
      Return(True)
   EndIf

   If k = 1
      If c = #LIM
         Return(G.P[o].limit = False And G.P[o].saf[3] = False)
      EndIf
      If G.P[o].status <> #ROLL Then Return(False)
      If G.P[o].saf[p_SafIdx(c)] = True Then Return(False)
      Return(True)
   EndIf

   If k = 2
      Switch c
      Case #REP:    Return(st = #ACC)
      Case #FUEL:   Return(st = #GAS)
      Case #SPARE:  Return(st = #TIRE)
      Case #ENDLIM: Return(G.P[w].limit)
      Case #GO:     Return(st = #NEEDGO Or st = #STOP)
      EndSwitch
      Return(False)
   EndIf

   Return(True)   ; safeties can always be played
EndFunction

; Applies card c played by w. Returns True if the player gets an extra turn.
Function p_Apply(w, c)
   Local o, k, who$, hz
   o = 1 - w
   k = p_Kind(c)
   who$ = p_Who$(w)
   p_PlaySound()

   If k = 0
      G.P[w].km = G.P[w].km + p_DistKm(c)
      If c = #D200 Then G.P[w].n200 = G.P[w].n200 + 1
      p_Log(who$ .. " drove " .. p_Name$(c) .. "  (" .. p_S$(G.P[w].km) .. " km)")
      Return(False)
   EndIf

   If k = 1
      If c = #LIM
         G.P[o].limit = True
      Else
         G.P[o].status = c
      EndIf
      p_Log(who$ .. " played " .. p_Short$(c) .. " on " .. p_Obj$(o) .. "!")
      Return(False)
   EndIf

   If k = 2
      If c = #ENDLIM
         G.P[w].limit = False
      ElseIf c = #GO
         G.P[w].status = #ROLL
      Else
         If G.P[w].saf[3] = True
            G.P[w].status = #ROLL
         Else
            G.P[w].status = #NEEDGO
         EndIf
      EndIf
      p_Log(who$ .. " played " .. p_Short$(c))
      Return(False)
   EndIf

   ; ---- safeties ----
   G.P[w].saf[c - 15] = True
   If c = #ROW
      G.P[w].limit = False
      If G.P[w].status = #NEEDGO Or G.P[w].status = #STOP Then G.P[w].status = #ROLL
   Else
      hz = c - 10    ; ACE->ACC, TANK->GAS, PROOF->TIRE
      If G.P[w].status = hz
         If G.P[w].saf[3] = True
            G.P[w].status = #ROLL
         Else
            G.P[w].status = #NEEDGO
         EndIf
      EndIf
   EndIf
   p_Log(who$ .. " played " .. p_Short$(c) .. " - extra turn!")
   Return(True)
EndFunction

Function p_Finish()
   Local msg$
   G.over = True
   If G.P[0].km = G.P[1].km
      msg$ = "It's a draw at " .. p_S$(G.P[0].km) .. " km!"
   ElseIf G.P[0].km > G.P[1].km
      msg$ = "You win!  " .. p_S$(G.P[0].km) .. " km to " .. p_S$(G.P[1].km) .. " km."
   Else
      msg$ = p_Who$(1) .. " wins.  " .. p_S$(G.P[1].km) .. " km to " .. p_S$(G.P[0].km) .. " km."
   EndIf
   p_Log("*** GAME OVER: " .. msg$)
   If G.mode = 1
      p_NetSend("RESULT " .. G.P[0].km .. " " .. G.P[1].km)
      p_NetSend("LEAVE")   ; back to the server lobby
   EndIf
   p_Refresh()
   moai.Request("Game over", msg$, "OK")
EndFunction

; returns True (and finishes the game) if the game is over
Function p_CheckEnd()
   If G.over = True Then Return(True)
   If G.P[0].km = 1000 Or G.P[1].km = 1000
      p_Finish()
      Return(True)
   EndIf
   If G.dn = 0 And G.P[0].hn = 0 And G.P[1].hn = 0
      p_Finish()
      Return(True)
   EndIf
   Return(False)
EndFunction

; ============================================================================
;  COMPUTER PLAYER
; ============================================================================
Function p_Score(c)
   Local k, s, st
   k = p_Kind(c)
   st = G.P[1].status
   If k = 0
      s = 30 + p_DistKm(c) / 10
      If G.P[1].km + p_DistKm(c) = 1000 Then s = 200
      Return(s)
   EndIf
   If k = 1
      If c = #LIM Then Return(35)
      If c = #STOP Then s = 70 Else s = 75
      If G.P[0].km >= 700 Then s = s + 20
      Return(s)
   EndIf
   If k = 2
      If c = #ENDLIM Then Return(50)
      Return(95)
   EndIf
   If c - 10 = st Then Return(100)
   Return(90)
EndFunction

Function p_Keep(c)
   ; how much the computer wants to hold on to a card (lowest gets discarded)
   Local k
   k = p_Kind(c)
   If k = 0 Then Return(10 + p_DistKm(c) / 20)
   If k = 3 Then Return(100)
   If k = 1
      If c = #LIM
         If G.P[0].saf[3] = True Then Return(2)
         Return(12)
      EndIf
      If G.P[0].saf[p_SafIdx(c)] = True Then Return(2)
      Return(15)
   EndIf
   ; remedies
   Switch c
   Case #REP:    If G.P[1].saf[0] = True Then Return(0)
   Case #FUEL:   If G.P[1].saf[1] = True Then Return(0)
   Case #SPARE:  If G.P[1].saf[2] = True Then Return(0)
   Case #ENDLIM: If G.P[1].saf[3] = True Then Return(0)
   Case #GO:     If G.P[1].saf[3] = True Then Return(0)
   EndSwitch
   If c = #GO Then Return(50)
   Return(40)
EndFunction

Function p_AITurn()
   Local again, slot, i, best, bestS, s, c
   Repeat
      again = False
      p_Draw(1)
      If G.P[1].hn = 0 Then Return

      best = -1
      bestS = 0
      For i = 0 To G.P[1].hn - 1
         If p_CanPlay(1, G.P[1].hand[i]) = True
            s = p_Score(G.P[1].hand[i])
            If s > bestS
               bestS = s
               best = i
            EndIf
         EndIf
      Next

      If best >= 0
         c = G.P[1].hand[best]
         p_Remove(1, best)
         again = p_Apply(1, c)
      Else
         best = 0
         bestS = p_Keep(G.P[1].hand[0])
         For i = 1 To G.P[1].hn - 1
            s = p_Keep(G.P[1].hand[i])
            If s < bestS
               bestS = s
               best = i
            EndIf
         Next
         c = G.P[1].hand[best]
         p_Remove(1, best)
         p_Log("Computer discarded " .. p_Short$(c))
      EndIf

      If p_CheckEnd() = True Then Return
   Until again = False
EndFunction

; ============================================================================
;  HUMAN PLAYER
; ============================================================================
Function p_EndHumanTurn()
   p_AITurn()
   If G.over = True Then Return
   ; if the human has run out of cards (empty deck) the computer keeps playing
   While G.P[0].hn = 0 And G.P[1].hn > 0 And G.over = False
      p_AITurn()
   Wend
   If G.over = True Then Return
   p_Draw(0)
   p_Refresh()
EndFunction

Function p_HumanPlay()
   Local c, extra, slot
   If G.over = True Then Return
   If G.myturn = False
      p_Log("It's not your turn yet.")
      Return
   EndIf
   If G.sel < 0 Or G.sel >= G.P[0].hn
      p_Log("Choose a card first: press its number (1-7) under your hand.")
      Return
   EndIf
   slot = G.sel
   c = G.P[0].hand[slot]
   If p_CanPlay(0, c) = False
      p_Log("You can't play " .. p_Short$(c) .. " right now. Discard it?")
      Return
   EndIf
   p_Remove(0, slot)
   extra = p_Apply(0, c)
   If G.mode = 1 Then p_NetSend("MOVE P " .. slot)
   If p_CheckEnd() = True Then Return
   If extra = True
      p_Draw(0)
      p_Refresh()
      Return
   EndIf
   If G.mode = 1
      G.myturn = False
      p_Refresh()
   Else
      p_Refresh()
      p_EndHumanTurn()
   EndIf
EndFunction

Function p_HumanDiscard()
   Local c, slot
   If G.over = True Then Return
   If G.myturn = False
      p_Log("It's not your turn yet.")
      Return
   EndIf
   If G.sel < 0 Or G.sel >= G.P[0].hn
      p_Log("Choose a card first: press its number (1-7) under your hand.")
      Return
   EndIf
   slot = G.sel
   c = G.P[0].hand[slot]
   p_Remove(0, slot)
   p_Log("You discarded " .. p_Short$(c))
   If G.mode = 1 Then p_NetSend("MOVE D " .. slot)
   If p_CheckEnd() = True Then Return
   If G.mode = 1
      G.myturn = False
      p_Refresh()
   Else
      p_Refresh()
      p_EndHumanTurn()
   EndIf
EndFunction

; ============================================================================
;  USER INTERFACE
; ============================================================================
Function p_Bar$(km)
   Local n, i, s$
   n = Int(km / 50)
   s$ = "["
   For i = 1 To 20
      If i <= n
         s$ = s$ .. "="
      Else
         s$ = s$ .. "-"
      EndIf
   Next
   Return(s$ .. "]")
EndFunction

Function p_StatusText$(w)
   Local st
   st = G.P[w].status
   Local s$
   Switch st
   Case #ROLL:   s$ = "Rolling"
   Case #NEEDGO: s$ = "Stopped - needs a GO card"
   Case #ACC:    s$ = "ACCIDENT - needs Repairs"
   Case #GAS:    s$ = "OUT OF GAS - needs Gasoline"
   Case #TIRE:   s$ = "FLAT TIRE - needs Spare Tire"
   Case #STOP:   s$ = "STOP - needs a GO card"
   EndSwitch
   If G.P[w].limit = True Then s$ = s$ .. "   |   SPEED LIMIT 50"
   Return(s$)
EndFunction

Function p_SafetyText$(w)
   Local s$
   s$ = ""
   If G.P[w].saf[0] = True Then s$ = s$ .. "Driving Ace  "
   If G.P[w].saf[1] = True Then s$ = s$ .. "Extra Tank  "
   If G.P[w].saf[2] = True Then s$ = s$ .. "Puncture-Proof  "
   If G.P[w].saf[3] = True Then s$ = s$ .. "Right of Way  "
   If s$ = "" Then s$ = "(no safeties)"
   Return("Safeties: " .. s$ .. "   |   200s: " .. p_S$(G.P[w].n200) .. "/2")
EndFunction

; Card colours for the hand display (RRGGBB). Hazards red, remedies green.
; Every line gets an explicit colour, so nothing depends on how a colour
; "ends". The neutral colour is used for distance cards and safeties; change
; it here if you prefer another one.
Function p_CardColor$(c)
   Local k
   k = p_Kind(c)
   If k = 1 Then Return("E0302B")    ; hazard: red
   If k = 2 Then Return("1E9A33")    ; remedy: green
   Return("707070")                  ; distance / safety
EndFunction

Function p_HandText$()
   Local i, c, t$, l$
   t$ = ""
   For i = 0 To 6                      ; always exactly seven lines
      If i > 0 Then t$ = t$ .. "\n"
      If i < G.P[0].hn
         c = G.P[0].hand[i]
         l$ = "\27P[" .. p_CardColor$(c) .. "]"
         If i = G.sel
            l$ = l$ .. "\27b> "
         Else
            l$ = l$ .. "   "
         EndIf
         l$ = l$ .. p_S$(i + 1) .. ".  " .. p_Name$(c)
         If p_CanPlay(0, c) = True Then l$ = l$ .. "     <- playable"
         If i = G.sel Then l$ = l$ .. "\27n"
         t$ = t$ .. l$
      Else
         t$ = t$ .. " "                ; empty slot
      EndIf
   Next
   Return(t$)
EndFunction

Function p_ShowHand()
   moai.Set("hand", "text", p_HandText$())
EndFunction

Function p_SelectCard(i)
   If G.over = True Then Return
   If i >= G.P[0].hn
      p_Log("You only have " .. p_S$(G.P[0].hn) .. " cards.")
      Return
   EndIf
   G.sel = i
   p_ShowHand()
EndFunction

Function p_Refresh()
   Local i, c, w, t$
   For w = 0 To 1
      moai.Set("km" .. p_S$(w), "text", p_Bar$(G.P[w].km) .. "  " .. p_S$(G.P[w].km) .. " / 1000 km")
      moai.Set("st" .. p_S$(w), "text", p_StatusText$(w))
      moai.Set("sf" .. p_S$(w), "text", p_SafetyText$(w))
   Next
   t$ = "Draw pile: " .. p_S$(G.dn) .. " cards     " .. G.oppname .. " holds " .. p_S$(G.P[1].hn) .. " cards"
   If G.mode = 1 And G.over = False
      If G.myturn = True
         t$ = t$ .. "     >>> YOUR TURN <<<"
      Else
         t$ = t$ .. "     Waiting for " .. G.oppname .. "..."
      EndIf
   EndIf
   moai.Set("deckinfo", "text", t$)

   G.sel = -1
   p_ShowHand()
EndFunction

Function p_NewGameAI()
   Local w, i
   If G.net = True Then p_NetSend("LEAVE")   ; leave a match / cancel a search
   G.mode = 0
   G.myturn = True
   G.oppname = "Computer"
   G.P = {}
   For w = 0 To 1
      G.P[w] = p_NewPlayer()
   Next
   p_BuildDeck()
   For i = 1 To 6
      p_Draw(0)
      p_Draw(1)
   Next
   p_Draw(0)
   G.over = False
   G.sel = -1
   moai.DoMethod("log", "clear")
   p_Log("New game vs the Computer! First to exactly 1000 km wins. You need a GO card to get rolling.")
   p_Refresh()
EndFunction

; ============================================================================
;  ONLINE PLAY  (text protocol, one line per message, see server/PROTOCOL.md)
; ============================================================================
Function p_NetSend(s$)
   If G.net = True Then SendData(#NETID, s$ .. "\n")
EndFunction

Function p_NetClose()
   If G.net = True
      CloseConnection(#NETID)
      G.net = False
   EndIf
   p_ResetSession()
EndFunction

; the "Status:" line in the Online panel
Function p_UpdateLoginStatus()
   Local t$
   If G.net = False
      t$ = "Status: not connected"
   ElseIf G.login <> ""
      t$ = "Status: LOGGED IN as " .. G.login .. G.lsuffix
   ElseIf G.welcomed = True
      t$ = "Status: connected as guest " .. G.myname .. " (not logged in)"
   Else
      t$ = "Status: connecting..."
   EndIf
   moai.Set("lstat", "text", t$)
EndFunction

Function p_ResetSession()
   G.welcomed = False
   G.login = ""
   G.lsuffix = ""
   G.fcnt = 0
   G.sc = 0
   G.fsel = -1
   G.pop = ""
   moai.DoMethod("friends", "clear")
   p_UpdateLoginStatus()
EndFunction

Function p_SendIntro()
   Local name$, pw$
   name$ = p_Clean$(moai.Get("pname", "text"))
   pw$ = moai.Get("pass", "text")
   If name$ = "" Then name$ = "Player"
   G.myname = name$
   If pw$ = ""
      p_NetSend("HELLO " .. name$)       ; guest: no stats, no friends
   Else
      p_NetSend("LOGIN " .. name$ .. " " .. pw$)
   EndIf
EndFunction

Function p_FindMatch()
   Local host$, port, room$, err, pw$
   room$ = p_Clean$(moai.Get("room", "text"))
   pw$ = moai.Get("pass", "text")
   If ReplaceStr(pw$, " ", "") <> pw$
      p_Log("The password must not contain spaces.")
      Return
   EndIf
   If G.net = False
      host$ = moai.Get("host", "text")
      port = ToNumber(moai.Get("port", "text"))
      p_Log("Connecting to " .. host$ .. ":" .. p_S$(port) .. " ...")
      ExitOnError(False)
      OpenConnection(#NETID, host$, port)
      err = GetLastError()
      ExitOnError(True)
      If err <> 0
         p_Log("Could not connect to the server.")
         Return
      EndIf
      G.net = True
      G.rx = ""
      p_ResetSession()
   EndIf
   If G.welcomed = False Then p_SendIntro()
   If room$ = ""
      p_NetSend("FIND")
   Else
      p_NetSend("FIND " .. room$)
   EndIf
EndFunction

; ---- friends panel --------------------------------------------------------
Function p_NeedLogin()
   If G.net = True And G.login <> "" Then Return(True)
   p_Log("Friends need an account: enter a name and password in the Online panel and press Find opponent (or press Log in).")
   Return(False)
EndFunction

Function p_FAdd(n$, kind, st$)
   G.fn[G.fcnt] = n$
   G.ft[G.fcnt] = kind
   G.fs[G.fcnt] = st$
   G.fcnt = G.fcnt + 1
EndFunction

Function p_ShowFriends()
   Local i, t$
   moai.DoMethod("friends", "clear")
   For i = 0 To G.fcnt - 1
      If G.ft[i] = 0
         t$ = G.fn[i] .. "   [" .. G.fs[i] .. "]"
      Else
         t$ = "REQUEST: " .. G.fn[i] .. " wants to be your friend"
      EndIf
      moai.DoMethod("friends", "insert", "bottom", t$)
      G.sn[i] = G.fn[i]
      G.sk[i] = G.ft[i]
   Next
   G.sc = G.fcnt
   G.fcnt = 0
   G.fsel = -1
EndFunction

Function p_ResWord$(r$)
   Switch r$
   Case "W": Return("won")
   Case "L": Return("lost")
   Case "D": Return("draw")
   Case "F": Return("forfeited")
   Case "X": Return("disputed")
   EndSwitch
   Return(r$)
EndFunction

Function p_ShowPopup(title$, empty$)
   If G.pop = "" Then G.pop = empty$ .. "\n"
   moai.Request(title$, G.pop, "OK")
   G.pop = ""
EndFunction

Function p_Connect()
   ; connect and log in without searching for a match
   Local host$, port, err, pw$
   pw$ = moai.Get("pass", "text")
   If ReplaceStr(pw$, " ", "") <> pw$
      p_Log("The password must not contain spaces.")
      Return
   EndIf
   If G.net = False
      host$ = moai.Get("host", "text")
      port = ToNumber(moai.Get("port", "text"))
      p_Log("Connecting to " .. host$ .. ":" .. p_S$(port) .. " ...")
      ExitOnError(False)
      OpenConnection(#NETID, host$, port)
      err = GetLastError()
      ExitOnError(True)
      If err <> 0
         p_Log("Could not connect to the server.")
         Return
      EndIf
      G.net = True
      G.rx = ""
      p_ResetSession()
   EndIf
   If G.welcomed = False Then p_SendIntro()
EndFunction

Function p_StartNet(seat, opp$, csv$)
   Local d, n, i, w
   d, n = SplitStr(csv$, ",")
   If n <> 106
      p_Log("*** Server sent a bad deck - match cancelled.")
      p_NetSend("LEAVE")
      Return
   EndIf
   G.mode = 1
   G.seat = seat
   G.oppname = opp$
   G.deck = {}
   For i = 0 To n - 1
      G.deck[i] = ToNumber(d[i])
   Next
   G.dn = n
   G.P = {}
   For w = 0 To 1
      G.P[w] = p_NewPlayer()
   Next
   ; both clients deal in the same order: seat 0 first, then seat 1
   For i = 1 To 6
      If seat = 0
         p_Draw(0)
         p_Draw(1)
      Else
         p_Draw(1)
         p_Draw(0)
      EndIf
   Next
   G.over = False
   G.sel = -1
   moai.DoMethod("log", "clear")
   p_Log("Match found! You are playing " .. opp$ .. ".")
   If seat = 0
      p_Draw(0)
      G.myturn = True
      p_Log("You go first.")
   Else
      G.myturn = False
      p_Log(opp$ .. " goes first.")
   EndIf
   p_Refresh()
EndFunction

; start of my turn: draw, or pass if I have no cards left (empty pile)
Function p_StartMyTurn()
   p_Draw(0)
   G.myturn = True
   If G.P[0].hn = 0
      p_Log("You have no cards left - passing.")
      p_NetSend("MOVE X")
      G.myturn = False
   EndIf
   p_Refresh()
EndFunction

; the opponent's move arrived
Function p_OppMove(kind$, slot)
   Local c, extra, ok
   If G.over = True Then Return
   If G.mode <> 1 Then Return
   If G.myturn = True Then Return
   p_Draw(1)
   extra = False
   ok = True
   If kind$ = "X"
      p_Log(G.oppname .. " has no cards and passes.")
   ElseIf slot < 0 Or slot >= G.P[1].hn
      ok = False
   Else
      c = G.P[1].hand[slot]
      If kind$ = "P"
         If p_CanPlay(1, c) = False Then ok = False
      ElseIf kind$ <> "D"
         ok = False
      EndIf
      If ok = True
         p_Remove(1, slot)
         If kind$ = "P"
            extra = p_Apply(1, c)
         Else
            p_Log(G.oppname .. " discarded " .. p_Short$(c))
         EndIf
      EndIf
   EndIf
   If ok = False
      G.over = True
      p_Log("*** Out of sync with the opponent - game aborted.")
      p_NetSend("RESULT " .. G.P[0].km .. " " .. G.P[1].km)
      p_NetSend("LEAVE")
      p_Refresh()
      Return
   EndIf
   If p_CheckEnd() = True Then Return
   If extra = True
      p_Refresh()   ; safety card: the opponent moves again
      Return
   EndIf
   p_StartMyTurn()
EndFunction

Function p_NetLine(line$)
   Local f, c, cmd$, slot
   f, c = SplitStr(line$, " ")
   If c < 2
      cmd$ = line$
   Else
      cmd$ = f[0]
   EndIf
   Switch cmd$
   Case "WELCOME":
      G.welcomed = True
      p_Log("Connected to the server.")
      p_UpdateLoginStatus()
   Case "LOGGEDIN":
      If c >= 8
         G.login = f[1]
         G.lsuffix = "  (" .. f[2] .. " games, " .. f[3] .. " won)"
         p_UpdateLoginStatus()
         If f[7] = "NEW"
            p_Log("Account created! Welcome, " .. f[1] .. ". You are now logged in, and your online games will be recorded.")
            p_Log("Remember your password: use the same name and password to log in next time.")
         Else
            p_Log("Logged in as " .. f[1] .. ": " .. f[2] .. " games, " .. f[3] .. " won, " .. f[4] .. " lost.")
         EndIf
         p_NetSend("FRIENDS")
      EndIf
   Case "WAIT":
      p_Log("Searching for an opponent... (press New game to cancel)")
   Case "MATCH":
      If c >= 4 Then p_StartNet(ToNumber(f[1]), f[2], f[3])
   Case "OPP":
      slot = -1
      If c >= 3 Then slot = ToNumber(f[2])
      If c >= 2 Then p_OppMove(f[1], slot)
   Case "OPPLEFT":
      If G.mode = 1 And G.over = False
         G.over = True
         p_Log("*** " .. G.oppname .. " left the game.")
         p_Refresh()
         moai.Request("Game over", G.oppname .. " left the game.", "OK")
      EndIf
   Case "FRIEND":
      If c >= 3 Then p_FAdd(f[1], 0, f[2])
   Case "REQUEST":
      If c >= 2 Then p_FAdd(f[1], 1, "")
   Case "ENDFRIENDS":
      p_ShowFriends()
   Case "FRIENDREQ":
      If c >= 2 Then p_Log(f[1] .. " sent you a friend request.")
      p_NetSend("FRIENDS")
   Case "FRIENDADDED":
      If c >= 2 Then p_Log("You and " .. f[1] .. " are now friends.")
      p_NetSend("FRIENDS")
   Case "FRIENDREMOVED":
      If c >= 2 Then p_Log(f[1] .. " removed you from their friends.")
      p_NetSend("FRIENDS")
   Case "FRIENDON":
      If c >= 2 Then p_Log("Your friend " .. f[1] .. " is online.")
      p_NetSend("FRIENDS")
   Case "FRIENDOFF":
      p_NetSend("FRIENDS")
   Case "STATS":
      If c >= 7
         moai.Request("Stats: " .. f[1], "Games played: " .. f[2] .. "\nWon: " .. f[3] .. "\nLost: " .. f[4] .. "\nDrawn: " .. f[5] .. "\nForfeits: " .. f[6], "OK")
      EndIf
   Case "GAME":
      If c >= 6 Then G.pop = G.pop .. f[3] .. " km to " .. f[4] .. " km against " .. f[2] .. " - " .. p_ResWord$(f[5]) .. "\n"
   Case "ENDHISTORY":
      If c >= 2 Then p_ShowPopup("Recent games: " .. f[1], "No games played yet.")
   Case "LEADER":
      If c >= 5 Then G.pop = G.pop .. f[1] .. ". " .. f[2] .. "  -  " .. f[3] .. " won of " .. f[4] .. " played\n"
   Case "ENDLEADERS":
      p_ShowPopup("Leaderboard", "No games recorded yet.")
   Case "OK":
      p_Log(line$)
   Case "ERR":
      p_Log("Server: " .. line$)
      If G.welcomed = False Then moai.Set("lstat", "text", "Status: not logged in - " .. line$)
   EndSwitch
EndFunction

Function p_NetProcess()
   Local parts, n, i
   parts, n = SplitStr(G.rx, "\n")
   If n < 2 Then Return       ; no complete line yet
   For i = 0 To n - 2
      p_NetLine(parts[i])
   Next
   If G.net = True Then G.rx = parts[n - 1]
EndFunction

Function p_NetEvent(msg)
   Local a$, nbytes
   Switch msg.action
   Case "OnReceiveData":
      a$, nbytes = ReceiveData(msg.id, #RECEIVEALL, False)
      a$ = ReplaceStr(a$, "\r", "")
      G.rx = G.rx .. a$
      p_NetProcess()
   Case "OnDisconnect":
      CloseConnection(msg.id)
      G.net = False
      G.rx = ""
      p_ResetSession()
      If G.mode = 1 And G.over = False
         G.over = True
         p_Log("*** Connection to the server lost.")
         p_Refresh()
      Else
         p_Log("Disconnected from the server.")
      EndIf
   EndSwitch
EndFunction

Function p_Rules()
   Local t$
   t$ = ""
   t$ = t$ .. "Goal: be the first to travel exactly 1000 km.\n\n"
   t$ = t$ .. "Each turn you draw a card, then play or discard one.\n\n"
   t$ = t$ .. "DISTANCE cards move you, but only while rolling. You need a GO card to start, "
   t$ = t$ .. "and again after every hazard is repaired. Only two 200 km cards per game. "
   t$ = t$ .. "Under a SPEED LIMIT you may only play 25 or 50 km.\n\n"
   t$ = t$ .. "HAZARDS (Accident, Out of Gas, Flat Tire, Stop) can only be played on a "
   t$ = t$ .. "rolling opponent; Speed Limit can be played any time.\n\n"
   t$ = t$ .. "REMEDIES: Repairs, Gasoline, Spare Tire fix their hazard (then you need GO). "
   t$ = t$ .. "GO fixes Stop. End of Limit removes the speed limit.\n\n"
   t$ = t$ .. "SAFETIES give permanent protection and an extra turn. Right of Way makes "
   t$ = t$ .. "you immune to Stop and Speed Limit and means you never need GO.\n\n"
   t$ = t$ .. "If the draw pile runs out, whoever has gone farthest wins.\n\n"
   t$ = t$ .. "ACCOUNTS: if the server has accounts turned on, enter a password to log in "
   t$ = t$ .. "(a new name creates the account). Your online games are then recorded and "
   t$ = t$ .. "you can add friends.\n\n"
   t$ = t$ .. "ONLINE: fill in the server, your name and (optionally) a room code, then "
   t$ = t$ .. "press Find opponent. Two players who use the same room code are matched "
   t$ = t$ .. "together; with no code you are matched with the next random player.\n\n"
   t$ = t$ .. "(Simplified: no coup fourre, no scoring bonuses.)"
   moai.Request("HollyBornes - Rules", t$, "OK")
EndFunction

Function p_About()
   Local t$
   t$ = ""
   t$ = t$ .. "HollyBornes 1.8\n\n"
   t$ = t$ .. "A Hollywood take on the classic French road-race card game Mille Bornes,\n"
   t$ = t$ .. "written in Hollywood with RapaGUI.\n\n"
   t$ = t$ .. "Play against the Computer, or online against\n"
   t$ = t$ .. "another player through the matchmaking server,\n"
   t$ = t$ .. "and be the first to travel exactly 1000 km."
   moai.Request("About HollyBornes", t$, "OK")
EndFunction

Function p_FriendAdd()
   Local n$
   If p_NeedLogin() = False Then Return
   n$ = p_Clean$(moai.Get("fname", "text"))
   If n$ = ""
      p_Log("Type the player's name next to Add friend first.")
      Return
   EndIf
   p_NetSend("FRIEND ADD " .. n$)
EndFunction

; act on the selected entry of the friends list.
; ACCEPT only works on requests (kind 1); REMOVE removes a friend (kind 0)
; or declines a request (kind 1).
Function p_FriendSelected(what$, onlykind)
   Local i
   If p_NeedLogin() = False Then Return
   i = G.fsel
   If i < 0 Or i >= G.sc
      p_Log("Select someone in the friends list first.")
      Return
   EndIf
   If what$ = "ACCEPT"
      If G.sk[i] <> 1
         p_Log("Select a friend request to accept.")
         Return
      EndIf
      p_NetSend("FRIEND ACCEPT " .. G.sn[i])
   Else
      If G.sk[i] = 1
         p_NetSend("FRIEND DECLINE " .. G.sn[i])
      Else
         p_NetSend("FRIEND REMOVE " .. G.sn[i])
      EndIf
   EndIf
   p_NetSend("FRIENDS")
EndFunction

; STATS / HISTORY of the name in the friends box, or of yourself if it is empty
Function p_AskPlayer(cmd$)
   Local n$
   If G.net = False
      p_Log("Connect to a server first.")
      Return
   EndIf
   n$ = p_Clean$(moai.Get("fname", "text"))
   If n$ = "" And G.login = ""
      p_Log("Log in, or type a player's name in the friends box.")
      Return
   EndIf
   If n$ = ""
      p_NetSend(cmd$)
   Else
      p_NetSend(cmd$ .. " " .. n$)
   EndIf
EndFunction

; Quit the program. Closing the connection first means an online opponent is
; told straight away (leaving a game in progress counts as a forfeit).
Function p_Quit()
   If G.net = True
      CloseConnection(#NETID)
      G.net = False
   EndIf
   End
EndFunction

Function p_Event(msg)
   Switch msg.class
   Case "Window":
      If msg.attribute = "CloseRequest" Then p_Quit()

   Case "Menuitem":
      If msg.attribute = "Selected"
         Switch msg.id
         Case "mnew":
            p_NewGameAI()
         Case "mfind":
            p_FindMatch()
         Case "mrules":
            p_Rules()
         Case "msound":
            p_ToggleSound()
         Case "mabout":
            p_About()
         Case "mquit":
            p_Quit()
         EndSwitch
      EndIf

   Case "Listview":
      If msg.id = "friends" And msg.attribute = "Active"
         If GetType(msg.triggervalue) = #NUMBER
            G.fsel = msg.triggervalue
         Else
            G.fsel = -1
         EndIf
      EndIf

   Case "Button":
      If msg.attribute = "Pressed"
         Switch msg.id
         Case "c0":
            p_SelectCard(0)
         Case "c1":
            p_SelectCard(1)
         Case "c2":
            p_SelectCard(2)
         Case "c3":
            p_SelectCard(3)
         Case "c4":
            p_SelectCard(4)
         Case "c5":
            p_SelectCard(5)
         Case "c6":
            p_SelectCard(6)
         Case "bplay":
            p_HumanPlay()
         Case "bdiscard":
            p_HumanDiscard()
         Case "bnew":
            p_NewGameAI()
         Case "bfind":
            p_FindMatch()
         Case "bdisc":
            p_NewGameAI()
            p_NetClose()
         Case "bconn":
            p_Connect()
         Case "bfadd":
            p_FriendAdd()
         Case "bfaccept":
            p_FriendSelected("ACCEPT", 1)
         Case "bfremove":
            p_FriendSelected("REMOVE", 0)
         Case "bfrefresh":
            If p_NeedLogin() = True Then p_NetSend("FRIENDS")
         Case "bstats":
            p_AskPlayer("STATS")
         Case "bhist":
            p_AskPlayer("HISTORY")
         Case "bleaders":
            If G.net = True
               p_NetSend("LEADERS")
            Else
               p_Log("Connect to a server first.")
            EndIf
         EndSwitch
      EndIf
   EndSwitch
EndFunction

; ============================================================================
;  MAIN
; ============================================================================
moai.CreateApp([[
<?xml version="1.0" encoding="iso-8859-1"?>
<application id="app">
   <menubar id="mb">
      <menu title="Game">
         <item id="mnew">New game vs computer</item>
         <item id="mfind">Find online opponent</item>
         <item id="mrules">Rules...</item>
         <item id="msound">Sound on / off</item>
         <item id="mabout">About...</item>
         <item/>
         <item id="mquit" shortcut="Ctrl+Q">Quit</item>
      </menu>
   </menubar>

   <window id="win" title="HollyBornes" menubar="mb" notify="closerequest">
      <vgroup>
         <hgroup>
            <vgroup frame="true" frametitle="You">
               <text id="km0"> </text>
               <text id="st0"> </text>
               <text id="sf0"> </text>
            </vgroup>
            <vgroup frame="true" frametitle="Opponent">
               <text id="km1"> </text>
               <text id="st1"> </text>
               <text id="sf1"> </text>
            </vgroup>
         </hgroup>

         <text id="deckinfo"> </text>

         <vgroup frame="true" frametitle="Your hand - choose a card (1-7), then Play or Discard">
            <textview id="hand" styled="true" height="190">
 
 
 
 
 
 
 </textview>
            <hgroup>
               <button id="c0">1</button>
               <button id="c1">2</button>
               <button id="c2">3</button>
               <button id="c3">4</button>
               <button id="c4">5</button>
               <button id="c5">6</button>
               <button id="c6">7</button>
            </hgroup>
            <hgroup>
               <button id="bplay">Play card</button>
               <button id="bdiscard">Discard card</button>
               <button id="bnew">New game</button>
            </hgroup>
         </vgroup>

         <hgroup>
            <vgroup frame="true" frametitle="Play online (2 players)">
               <text id="lstat">Status: not connected</text>
               <hgroup>
                  <label>Server:</label>
                  <textentry id="host">millebornes.gameplayer.club</textentry>
                  <label>Port:</label>
                  <textentry id="port">5555</textentry>
               </hgroup>
               <hgroup>
                  <label>Name:</label>
                  <textentry id="pname">Player</textentry>
                  <label>Password:</label>
                  <textentry id="pass" password="1"/>
               </hgroup>
               <hgroup>
                  <label>Room code:</label>
                  <textentry id="room"/>
               </hgroup>
               <hgroup>
                  <button id="bfind">Find opponent</button>
                  <button id="bconn">Log in</button>
                  <button id="bdisc">Disconnect</button>
               </hgroup>
            </vgroup>

            <vgroup frame="true" frametitle="Friends (needs a password login)">
               <listview id="friends" notify="active">
                  <column/>
               </listview>
               <hgroup>
                  <textentry id="fname"/>
                  <button id="bfadd">Add friend</button>
               </hgroup>
               <hgroup>
                  <button id="bfaccept">Accept</button>
                  <button id="bfremove">Remove / Decline</button>
                  <button id="bfrefresh">Refresh</button>
               </hgroup>
               <hgroup>
                  <button id="bstats">Stats</button>
                  <button id="bhist">History</button>
                  <button id="bleaders">Leaderboard</button>
               </hgroup>
            </vgroup>
         </hgroup>

         <vgroup frame="true" frametitle="Game log (newest first)">
            <listview id="log">
               <column/>
            </listview>
         </vgroup>
      </vgroup>
   </window>
</application>
]])

InstallEventHandler({RapaGUI = p_Event, OnReceiveData = p_NetEvent, OnDisconnect = p_NetEvent})

p_InitSound()
p_NewGameAI()

Repeat
   WaitEvent
Forever
