<?xml version="1.0" encoding="iso-8859-1"?>	
<dialog id="dlg" title="About..." width="400">
	<vgroup>
		<colgroup columns="2">
			<label>Last name</label>
			<textentry id="lastname" advanceoncr="true"/>
			<label>First name</label>
			<textentry id="firstname" advanceoncr="true"/>
		</colgroup>	
		<hgroup>
			<button id="cancel" hint="negative">Ok</button>
		</hgroup>	
	</vgroup>					
</dialog>
